    USERS {
        bigint id PK
        varchar email UK
        varchar role
        varchar account_status
        boolean email_verified
    }
    OAUTH_IDENTITIES {
        bigint id PK
        bigint user_id FK
        varchar identity_provider
        varchar provider_subject UK
    }
    CUSTOMER_PROFILES {
        bigint id PK
        bigint user_id FK_UK
        varchar location
    }
    PROVIDER_PROFILES {
        bigint id PK
        bigint user_id FK_UK
        decimal hourly_rate
        double rating
        boolean is_approved
    }
    SKILLS {
        bigint id PK
        varchar name UK
    }
    PROVIDER_SKILLS {
        bigint provider_profile_id PK_FK
        bigint skill_id PK_FK
    }
    SERVICES {
        bigint id PK
        bigint provider_id FK
        varchar name
        decimal price
        varchar status
    }
    SERVICE_SKILLS {
        bigint service_id PK_FK
        bigint skill_id PK_FK
    }
    SERVICE_REQUESTS {
        bigint id PK
        bigint customer_id FK
        decimal budget
        date deadline
        varchar status
    }
    SERVICE_REQUEST_SKILLS {
        bigint request_id PK_FK
        bigint skill_id PK_FK
    }
    APPLIES {
        bigint id PK
        bigint request_id FK
        bigint provider_id FK
        decimal proposed_price
    }
    CARTS {
        bigint id PK
        bigint customer_id FK
        varchar status
    }
    CART_ITEMS {
        bigint id PK
        bigint cart_id FK
        bigint service_id FK
        int quantity
        decimal unit_price_snapshot
    }
    BOOKINGS {
        bigint id PK
        bigint customer_id FK
        bigint provider_id FK
        bigint service_id FK
        date booking_date
        varchar status
    }
    RENTAL_ORDERS {
        bigint id PK
        bigint customer_id FK
        bigint booking_id FK_UK
        bigint provider_id FK_nullable
        decimal total
        varchar status
    }
    RENTAL_ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint service_id FK_nullable
        bigint provider_id FK
        bigint booking_id FK_UK_nullable
        decimal line_total
    }
    RENTAL_ORDER_STATUS_HISTORY {
        bigint id PK
        bigint order_id FK
        varchar previous_status
        varchar new_status
    }
    PAYMENTS {
        bigint id PK
        bigint order_id FK_UK
        varchar gateway_name
        varchar status
        decimal amount
    }
    PAYMENT_ATTEMPTS {
        bigint id PK
        bigint payment_id FK
        int attempt_number
        varchar merchant_reference UK
        varchar status
    }
    REFUNDS {
        bigint id PK
        bigint payment_id FK
        bigint requested_by_user_id FK
        decimal amount
        varchar status
    }
    REVIEWS {
        bigint id PK
        bigint order_id FK_UK
        bigint service_id FK_nullable
        int rating
    }
    COMPLAINTS {
        bigint id PK
        bigint reporter_id FK_nullable
        bigint reported_user_id FK_nullable
        bigint order_id FK_nullable
        varchar status
    }
    CONVERSATIONS {
        bigint id PK
        bigint customer_id FK
        bigint provider_id FK
    }
    MESSAGES {
        bigint id PK
        bigint conversation_id FK
        bigint sender_id FK
        datetime sent_at
    }

    USER_WALLETS {
        bigint id PK
        bigint user_id FK_UK
        decimal available_balance
        decimal locked_balance
        datetime updated_at
    }
    WALLET_TRANSACTIONS {
        bigint id PK
        bigint wallet_id FK
        bigint rental_order_id FK_nullable
        varchar transaction_type
        decimal amount
        varchar status
        decimal balance_after
        datetime created_at
    }
